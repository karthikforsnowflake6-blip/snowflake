1)ROW_NUMBER()
  +++++++++++
  IT ASSIGN SEQUENTIAL INTEGER VALUE.
  
syntax:

  <function>() OVER ( PARTITION BY column ORDER BY column ASC/DESC);



EX:ASSIGN SEQUENCE NOT DEPT WISE(NO PARTITION BY)

select emp.*,ROW_NUMBER() OVER( ORDER BY SAL DESc) as rn
from emp;


Output
ENAME	SAL	RN
KING	5000	1
SCOTT	3000	2
FORD	3000	3

EX:ASSIGN SEQUENCE FROM EACH DEPT WISE(USE PARTITION BY)

select emp.*,ROW_NUMBER() OVER(PARTITION BY DEPTNO ORDER BY SAL DESc) as rn
from emp;

FIRST MAX SAL;(DONT USE PARTITION BY DEPTNO)

select *
from(select emp.*,ROW_NUMBER() OVER(ORDER BY SAL DESc) as rn
     from emp)
where rn=1;


Output
ENAME	SAL	RN
KING	5000	1


FIRST 3 MAX SAL (DONT USE PARTITION BY DEPTNO)

select *
from(select emp.*,ROW_NUMBER() OVER(ORDER BY SAL DESc) as rn
     from emp)
where rn<=3;


1ST MAX Salaries FROM EACH DEPT :(USE PARTITION BY DEPTNO)

select *
from(select emp.*,ROW_NUMBER() OVER(partition by deptno  ORDER BY SAL DESc) as rn
     from emp)
where rn<=1;


Top 3 Salaries FROM EACH DEPT :(USE PARTITION BY DEPTNO)

select *
from(select emp.*,ROW_NUMBER() OVER(partition by deptno  ORDER BY SAL DESc) as rn
     from emp)
where rn<=3;




  
