4)LAG()
+++++++
IT GIVES PREVIOUS ROW DATA.


Previous Employee Salary

SELECT EMPNO,ENAME,SAL,LAG(SAL) OVER(ORDER BY EMPNO) PREVSAL
FROM EMP;

Output
EMPNO	ENAME	SAL	PREVSAL
7369	SMITH	800	NULL
7499	ALLEN	1600	800
7521	WARD	1250	1600
7566	JONES	2975	1250


Salary Difference with Previous Employee:

SELECT EMPNO,ENAME,SAL,
       LAG(SAL) OVER(ORDER BY EMPNO) PREVSAL,
       SAL-LAG(SAL) OVER(ORDER BY EMPNO) DIFF
FROM EMP;

Output
EMPNO	ENAME	SAL	PREVSAL	DIFF
7369	SMITH	800	NULL	NULL
7499	ALLEN	1600	800	800
7521	WARD	1250	1600	-350
7566	JONES	2975	1250	1725

Employees Whose Salary MORE THAN  to Previous Employee

SELECT *
FROM(
    SELECT EMPNO,ENAME,SAL,
           LAG(SAL) OVER(ORDER BY EMPNO) PREVSAL
    FROM EMP
)
WHERE SAL > PREVSAL;

Output
EMPNO	ENAME	SAL	PREVSAL
7499	ALLEN	1600	800
7566	JONES	2975	1250

