AVG()
+++++

AVG() OVER() is a Window Function that calculates the average value.

EX:

SELECT ENAME,DEPTNO,SAL,AVG(SAL) OVER() AVG_SAL
FROM EMP;




SELECT ENAME,DEPTNO,SAL,AVG(SAL)OVER(PARTITION BY DEPTNO) AVG_SAL
FROM EMP;

EMPLOYEE DATA IF THERE SAL MORE THAN THEIR DEPT AVG SAL;

SELECT *
FROM(SELECT ENAME,DEPTNO,SAL,AVG(SAL)OVER(PARTITION BY DEPTNO) AVG_SAL
     FROM EMP)
WHERE SAL>AVG_SAL;


EMPLOYEE DATA IF THERE SAL LESS THAN THEIR DEPT AVG SAL;


SELECT *
FROM(SELECT ENAME,DEPTNO,SAL,AVG(SAL) OVER(PARTITION BY DEPTNO) AVG_SAL
     FROM EMP)
WHERE SAL<AVG_SAL;

