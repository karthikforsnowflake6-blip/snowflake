1)ROW_NUMBER()
  +++++++++++
  IT ASSIGN SEQUENTIAL INTEGER VALUE.
  
syntax:

  <function>() OVER ( PARTITION BY column ORDER BY column);



EX:ASSIGN SEQUENCE NOT DEPT WISE(NO PARTITION BY)

select emp.*,ROW_NUMBER() OVER( ORDER BY SAL DESc) as rn
from emp;


Output
ENAME	SAL	RN
KING	5000	1
SCOTT	3000	2
FORD	3000	3

EX:ASSIGN SEQUENCE FROM EACH DEPT WISE(USE PARTITION BY)

select emp.*,ROW_NUMBER() OVER(PARTITION BY DEPTNO ORDER BY SAL DESc) as rn
from emp;

FIRST MAX SAL;

select *
from(select emp.*,ROW_NUMBER() OVER(partition by deptno  ORDER BY SAL DESc) as rn
     from emp)
where rn=1;


Output
ENAME	SAL	RN
KING	5000	1
  
