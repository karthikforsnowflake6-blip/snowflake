

SUM():
++++++


DISPLAY TOTAL SALERY (14) EMP SAL IN ALL ROWS:

SELECT ENAME,SAL,SUM(SAL)OVER() TOTALSAL
FROM EMP;




DISPLAY TOTAL SALERY IN ACCORDING TO EACH DEPT.


SELECT ENAME,SAL,DEPTNO,SUM(SAL)OVER(PARTITION BY DEPTNO ) TOTALSAL
FROM EMP;








COUNT(*):
+++++++++


DISPLAY TOTAL NUMBER OF EMPLOYEES IN ALL THE ROWS.


SELECT ENAME,DEPTNO,COUNT(*)OVER() EMP_COUNT
FROM EMP;


DISPLAY TOTAL NUMBER OF EMPLOYEES IN THEIR DEPT.

SELECT ENAME,DEPTNO,COUNT(*)OVER(PARTITION BY DEPTNO) EMP_COUNT
FROM EMP;




SELECT *
FROM ( SELECT ENAME,DEPTNO,COUNT(*)OVER(PARTITION BY DEPTNO) EMP_COUNT
       FROM EMP)
WHERE EMP_COUNT>=6;


CTE=COMMON TABLE EXPRESSION:
++++++++++++++++++++++++++
IT IS A TEMPERORY RESULT SET USEDN TO IMPROVE THE READABILITY AND MAKES THE COMPLEX QUERY EASIER.
SYNTAX:

WITH CTE_NAME AS
(
    SELECT column1, column2
    FROM table_name
    WHERE condition
)
SELECT *
FROM CTE_NAME;


USING CTE:
----------

WITH MY_CTE AS(SELECT *
               FROM EMP
               WHERE  DEPTNO=10)

            SELECT *
            FROM MY_CTE;

WITHOUT CTE:


SELECT *
FROM EMP
WHERE  DEPTNO=10;


(BOTH ALSO SAME RESULT THEN WHY CTE)

THIS IS SIMPLE QUERY FOR SIMPLE QUERY CTE IS NOT COMPULSURY BUT FOR COMPLEX QUERY IT IS RECOMMENDED)


WITH MY_CTE AS(SELECT *
               FROM EMP
               WHERE  JOB=(SELECT JOB
                           FROM EMP
                           WHERE ENAME='SMITH')

                           SELECT *
                           FROM MY_CTE;


I WANT TO DISPLAY NUMBER OF EMPLOYEES WORKING IN EACH DEPT WITH DEPT DETAILS.

WITH MY_CTE AS (SELECT COUNT(*),DEPTNO
                FROM EMP
                GROUP BY DEPTNO)

            SELECT *
            FROM MY_CTE NATURAL JOIN DEPT;




RECURSIVE CTE:
++++++++++++++
Recursive CTE is a type of CTE that references itself to repeatedly UNTILL CONDITION BECOMES FALSE. 
SYNTAX:
               
WITH RECURSIVE CTE_NAME AS
(
    ANCHOR_QUERY

    UNION ALL

    RECURSIVE_QUERY
)
SELECT * FROM CTE_NAME;

PRINT 1 TO 5:

WITH RECURSIVE NUMS AS
(
    SELECT 1 AS N

    UNION ALL

    SELECT N + 1
    FROM NUMS
    WHERE N < 5
)
SELECT *
FROM NUMS;

PRINT EVEN NUMBERS FROM 1 TO 10;


WITH RECURSIVE NUMS AS
(
    SELECT 2 AS N

    UNION ALL

    SELECT N + 2
    FROM NUMS
    WHERE N < 10
)
SELECT * FROM NUMS;


PRINT ODD NUMBERS FROM 1 TO 10;


WITH RECURSIVE NUMS AS
(
    SELECT 1 AS N

    UNION ALL

    SELECT N + 2
    FROM NUMS
    WHERE N < 10
)
SELECT * FROM NUMS;


PRINT NUMBER FROM 5 TO 1;

WITH RECURSIVE NUMS AS
(
    SELECT 5 AS N

    UNION ALL

    SELECT N - 1
    FROM NUMS
    WHERE N > 1
)
SELECT *
FROM NUMS;






