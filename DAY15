
1)SIMPLE VIEW:
++++++++++++++


A View is a virtual table.
It does not store data physically.
IT DOESNOT OCCUPY SPACE
AND SIMPLE VIEW FROM SIGLE TABLE.


SYNTAX:
-------
CREATE VIEW VIEW_NAME
AS
SELECT *
FROM TABLE NAME
WHERE  FILTER CONDITION;

EX:

CREATE VIEW CLERK
AS
SELECT *
FROM EMP
WHERE JOB='CLERK';

(USING VIEW)

SELECT *
FROM CLERK;

(USING QUERY)

SELECT *
FROM EMP
WHERE JOB='CLERK';





CREATE VIEW CV
AS
SELECT SUM(SAL) AS TOTALSAL,DEPT.DEPTNO,DNAME
FROM EMP INNER JOIN DEPT 
     ON EMP.DEPTNO=DEPT.DEPTNO
GROUP BY DEPT.DEPTNO,DNAME;


     SELECT *
     FROM CV;


CREATE MATERIALIZED VIEW MV
AS
SELECT SUM(SAL) AS TOTALSAL,DEPTNO 
FROM EMP
GROUP BY DEPTNO;

SELECT * FROM MV;


