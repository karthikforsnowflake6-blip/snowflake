1. TO_CHAR :
+++++++++++

IT RETURN FORMATE MODELS FROM GIVEN DATE.

SYNTAX:

TO_CHAR(<DATE_OR_TIMESTAMP>, '<FORMAT_MODEL>');

1)YEAR FORMATS:

SELECT  TO_CHAR(CURRENT_TIMESTAMP(), 'YYYY');-----2025
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'YY');-----25
2). MONTH FORMATS:

SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MON') ;----JAN
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MMMM') ;----JANUARY
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MM')  ;-----(JANUARY---->01)

3) DAY FORMATS:

SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'DY');=---SAT

4) TIME FORMATS
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'HH24');-----(19) 07 PM
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'HH12');-----07
TO_CHAR(CURRENT_TIMESTAMP(), 'MI')  
TO_CHAR(CURRENT_TIMESTAMP(), 'SS')   AS SECOND;
🟢 6. FRACTIONAL SECONDS
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'FF3') AS MS;
🟢 7. IMPORTANT FULL DATE FORMAT
SELECT TO_CHAR(HIREDATE, 'DD-MON-YYYY') FROM EMP;
🟢 8. FILTERING QUERIES
Employees hired in December
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'MM') = '12';
Employees hired in 1981
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'YYYY') = '1981';
Employees hired on 17th
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'DD') = '17';
Employees hired in February
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'MM') = '02';
🟢 9. MONTH + YEAR DISPLAY
SELECT ENAME,
       TO_CHAR(HIREDATE,'MON-YYYY')
FROM EMP;
🟢 10. SPECIFIC MONTH + YEAR FILTER
SELECT *
FROM EMP
WHERE TO_CHAR(HIREDATE,'MON-YYYY') = 'APR-1981';
🟢 11. QUARTER LOGIC
SELECT EXTRACT(QUARTER FROM CURRENT_DATE);
🟢 12. WEEK LOGIC (your CEIL fix correct idea)
SELECT CEIL(TO_CHAR(CURRENT_DATE,'DD')/7);

👉 (this is manual logic, Snowflake has no direct WEEK OF MONTH function)

🟢 13. DAY FILTERING
SELECT ENAME,
       TO_CHAR(HIREDATE,'DY') AS DAY_NAME
FROM EMP;
Wednesday filter
SELECT *
FROM EMP
WHERE TO_CHAR(HIREDATE,'DY') = 'WED';
🟢 14. CURRENT DATE / TIME
SELECT TO_CHAR(CURRENT_DATE, 'DD-MON-YYYY');
SELECT TO_CHAR(CURRENT_TIMESTAMP, 'HH24:MI:SS');
