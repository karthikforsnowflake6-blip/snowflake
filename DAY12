1. TO_CHAR :
+++++++++++

IT RETURN FORMATE MODELS FROM GIVEN DATE.

SYNTAX:

TO_CHAR(<DATE_OR_TIMESTAMP>, '<FORMAT_MODEL>');

FORMATE_MODELS:
----------------

YEAR
+++++

YYYY
YY

MONTH
+++++

MON
MMMM
MM

DAY

++++

DY
DD

TIME
++++++
HH24
HH12
MI
SS

FRACTIONAL SECOND:
++++++++++++++++++
FF3



1)YEAR FORMATS:

SELECT  TO_CHAR(CURRENT_TIMESTAMP(), 'YYYY');-----2025
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'YY');-----25
2). MONTH FORMATS:

SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MON') ;----JAN
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MMMM') ;----JANUARY
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MM')  ;-----(JANUARY---->01)

3) DAY FORMATS:

SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'DY');=---SAT

4) TIME FORMATS
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'HH24');-----(19) 07 PM
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'HH12');-----07
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'MI') ;-------10
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'SS') ;-----55

5) FRACTIONAL SECONDS
SELECT TO_CHAR(CURRENT_TIMESTAMP(), 'FF3');-----MILLISECONDS----> 123

6). IMPORTANT FULL DATE FORMAT

SELECT TO_CHAR(HIREDATE, 'DD-MON-YYYY') FROM EMP;-----21-SEP-2026

EX:

Employees hired in December
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'MM') = '12';

Employees hired in 1981
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'YYYY') = '1981';

Employees hired on 17th
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'DD') = '17';

Employees hired in February
SELECT * 
FROM EMP
WHERE TO_CHAR(HIREDATE,'MM') = '02';



MONTH + YEAR DISPLAY

SELECT ENAME,TO_CHAR(HIREDATE,'MON-YYYY')
FROM EMP;------------JAN-2026





SPECIFIC MONTH + YEAR FILTER

SELECT *
FROM EMP
WHERE TO_CHAR(HIREDATE,'MON-YYYY') = 'APR-1981';



DAY FILTERING

SELECT ENAME,TO_CHAR(HIREDATE,'DY') 
FROM EMP;----------MON


Wednesday filter
SELECT *
FROM EMP
WHERE TO_CHAR(HIREDATE,'DY') = 'WED';


CURRENT DATE / TIME
SELECT TO_CHAR(CURRENT_DATE, 'DD-MON-YYYY');-----21-SEP-2026
SELECT TO_CHAR(CURRENT_TIMESTAMP, 'HH24:MI:SS');-----19:10:18












2)DATEDIFF() ;
+++++++++++++++

RETURN NO OF DAY/MONTH/YEAR BETWEEN GIVEN TWO DATE.

Syntax
DATEDIFF(DAY/MONTH/YEAR/HOUR/MINUTE/SECOND, <start_date>, <end_date>)

1) NO OF Days Difference:

SELECT DATEDIFF(DAY, '2026-06-01', '2026-06-11');
-- Output: 10
2)NO OF  Months Difference:

SELECT DATEDIFF(MONTH, '2026-01-01', '2026-04-01');
-- Output: 3
3)NO OF  Years Difference

SELECT DATEDIFF(YEAR, '2024-01-01', '2026-01-01');
-- Output: 2



4) Hours Difference
SELECT DATEDIFF(HOUR,
       '2026-06-18 10:00:00',
       '2026-06-18 15:00:00');
-- Output: 5

5) Minutes Difference

SELECT DATEDIFF(MINUTE,
       '2026-06-18 10:00:00',
       '2026-06-18 10:30:00');

-- Output: 30

6) Seconds Difference

SELECT DATEDIFF(SECOND,
       '2026-06-18 10:00:00',
       '2026-06-18 10:01:00');

-- Output: 60

 Employee Based Queries

 Employee Experience in Years

SELECT ENAME,HIREDATE,DATEDIFF(YEAR, HIREDATE, CURRENT_DATE()) AS EXP
FROM EMP;

 Days Worked by Employee

SELECT ENAME,DATEDIFF(DAY, HIREDATE, CURRENT_DATE()) AS DAYS_WORKED
FROM EMP;

Employees Worked More Than 40 Years

SELECT *
FROM EMP
WHERE DATEDIFF(YEAR, HIREDATE, CURRENT_DATE()) > 40;








3)DATEADD() :
++++++++++++
USED TO ADD DAY/MONTH/YEAR/HOUR/MINUTE/SECOND
Syntax
DATEADD(DAY/MONTH/YEAR/HOUR/MINUTE/SECOND, <value>, <date>)

Add Days:

SELECT DATEADD(DAY, 7, CURRENT_DATE());----2026-09-20----->2026-09-27

 Add Months

SELECT DATEADD(MONTH, 1, CURRENT_DATE());----2026-09-20------>2026-10-20

Add Years

SELECT DATEADD(YEAR, 1, CURRENT_DATE());-----2026-09-20------>2027-09-20

Practical Examples

Add 10 Days
SELECT DATEADD(DAY, 10, '2026-06-18');

Output:

2026-06-28

 Add 2 Months

SELECT DATEADD(MONTH, 2, '2026-06-18');

 Output:

2026-08-18



 Output:

2027-06-18

Subtract 5 Days

SELECT DATEADD(DAY, -5, '2026-06-18');

Output:

2026-06-13

Real-Time Use Cases
Employee Probation End Date (90 Days)---NOTICE PERIODE

SELECT DATEADD(DAY, 90, CURRENT_DATE()) ;

Employee Anniversary Date

SELECT ENAME,HIREDATE, DATEADD(YEAR, 1, HIREDATE) 
FROM EMP;


Add Hours:

SELECT DATEADD(HOUR, 5, '2026-06-18 10:00:00');
-- 2026-06-18 15:00:00.000

Add Minutes:

SELECT DATEADD(MINUTE, 15, '2026-06-18 10:00:00');
-- 2026-06-18 10:15:00.000

 Add Seconds:

SELECT DATEADD(SECOND, 30, '2026-06-18 10:00:00'); 

