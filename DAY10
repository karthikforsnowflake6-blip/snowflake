FROM EMP
WHERE SUBSTR(ENAME, 1, 1) NOT IN ('A','E','I','O','U');


ENAME ENS WITH VOWELS:

SELECT ENAME
FROM EMP
WHERE SUBSTR(ENAME, -1, 1) IN ('A','E','I','O','U');

OR

SELECT ENAME
FROM EMP
WHERE SUBSTR(ENAME, -1) IN ('A','E','I','O','U');





