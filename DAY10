FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
INNER JOIN DEPT D2 ON E2.DEPTNO = D2.DEPTNO
WHERE E2.JOB = 'PRESIDENT';

3. WAQTD ENAME , EMPLOYEE'S SALARY , MANAGER'S NAME ,
MANAGER'S SALARY ALONG WITH EMPLOYEES DNAME IF 
EMPLOYEE EARNS MORE THAN MANAGER.

SELECT E1.ENAME, E1.SAL, E2.ENAME, D1.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
INNER JOIN DEPT D1 ON E2.DEPTNO = D1.DEPTNO
WHERE D1.LOC = 'NEW YORK'
AND E2.SAL > 3000;

SELECT E1.ENAME, E1.SAL, E2.ENAME, E2.SAL, D1.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
INNER JOIN DEPT D1 ON E1.DEPTNO = D1.DEPTNO
WHERE E1.SAL > E2.SAL;

4. WAQTD ENAME , SAL MANAGER'S NAME MANAGER'S DNAME IF
MANAGER WORKS IN NEW YORK WITH SALARY MORE THAN 3000.

