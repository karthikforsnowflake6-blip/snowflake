10.WAQTD EMPLOYEE'S NAME WITH DNAME , MANAGER'S SAL WITH
DNAME ALONG WITH , MANAGER'S MANAGER'S JOB WITH DNAME IF
EMPLOYEE WORKS IN DEPT 10 , MANAGER WORKS AS PRESIDENT OR 
ACTUAL MANAGER AND MANAGER'S MANAGER SALARY MUST BE GREATER OR EQUAL TO MANAGER'S SALARY  .


SELECT E1.ENAME, D1.DNAME,
       E2.SAL, D2.DNAME,
       E3.JOB, D3.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN EMP E3 ON E2.MGR = E3.EMPNO
INNER JOIN DEPT D1 ON E1.DEPTNO = D1.DEPTNO
INNER JOIN DEPT D2 ON E2.DEPTNO = D2.DEPTNO
INNER JOIN DEPT D3 ON E3.DEPTNO = D3.DEPTNO
WHERE E1.DEPTNO = 10
AND E2.JOB IN ('PRESIDENT','MANAGER')
AND E3.SAL >= E2.SAL;

2️⃣ Manager is PRESIDENT – Salary + Location
SELECT E1.ENAME, E2.SAL, D.LOC
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT D ON E2.DEPTNO = D.DEPTNO
WHERE E2.JOB = 'PRESIDENT';
3️⃣ Employee earns more than Manager
SELECT E1.ENAME, E1.SAL, E2.ENAME, E2.SAL, D.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT D ON E1.DEPTNO = D.DEPTNO
WHERE E1.SAL > E2.SAL;
4️⃣ Manager in NEW YORK & SAL > 3000
SELECT E1.ENAME, E1.SAL, E2.ENAME, D.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT D ON E2.DEPTNO = D.DEPTNO
WHERE D.LOC = 'NEW YORK'
AND E2.SAL > 3000;
5️⃣ Employee & Manager same location
SELECT E1.ENAME, ED.DNAME, E2.ENAME, MD.DNAME
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT ED ON E1.DEPTNO = ED.DEPTNO
JOIN DEPT MD ON E2.DEPTNO = MD.DEPTNO
WHERE ED.LOC = MD.LOC;
6️⃣ Manager hired before Employee (Accounting)
SELECT E1.ENAME, E1.HIREDATE, E2.ENAME, E2.HIREDATE
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT D ON E1.DEPTNO = D.DEPTNO
WHERE D.DNAME = 'ACCOUNTING'
AND E2.HIREDATE < E1.HIREDATE;
7️⃣ Employee → Manager → Top Manager
SELECT E1.ENAME, E2.ENAME, E3.ENAME
FROM EMP E1
LEFT JOIN EMP E2 ON E1.MGR = E2.EMPNO
LEFT JOIN EMP E3 ON E2.MGR = E3.EMPNO;
8️⃣ Manager hired before 1982
SELECT E1.ENAME, D.DNAME, E2.ENAME, E2.HIREDATE
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
JOIN DEPT D ON E2.DEPTNO = D.DEPTNO
WHERE E2.HIREDATE < '1982-01-01';
9️⃣ Full hierarchy with dept
SELECT E1.ENAME, ED.DNAME, E2.ENAME, MD.DNAME, E3.ENAME, TD.DNAME
FROM EMP E1
LEFT JOIN EMP E2 ON E1.MGR = E2.EMPNO
LEFT JOIN EMP E3 ON E2.MGR = E3.EMPNO
LEFT JOIN DEPT ED ON E1.DEPTNO = ED.DEPTNO
LEFT JOIN DEPT MD ON E2.DEPTNO = MD.DEPTNO
