1. WAQTD ENAME MANAGER'S NAME AND EMPLOYEE'S LOCATION 
FOR THE EMPLOYEES WORKING AS 'CLERK'

SELECT E1.ENAME, E2.ENAME, D1.LOC
FROM EMP E1
JOIN EMP E2 ON E1.MGR = E2.EMPNO
INNER JOIN DEPT D1 ON E1.DEPTNO = D1.DEPTNO
