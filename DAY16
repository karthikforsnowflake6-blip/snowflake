CREATE OR REPLACE PROCEDURE VOTE()
RETURNS STRING
LANGUAGE SQL
AS
$$
DECLARE

    AGE NUMBER DEFAULT 20;
    
BEGIN

      RETURN iff(age>=18,'ELIGIBLE FOR VOTING','NOT ELIGIBLE FOR VOTING');

END;
$$;

call vote();



