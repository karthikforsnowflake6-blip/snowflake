--====================================================
-- STEP 11 : Check Stream
--====================================================
SELECT * FROM STUDENT_RAW;
SELECT * FROM STUDENT_STREAM;

--====================================================
-- STEP 12 : Execute Task
--====================================================

EXECUTE TASK PASS_STUDENT_TASK;

--====================================================
-- STEP 13 : Final Output
--====================================================

SELECT * FROM PASS_STUDENT;



STUDENT_RAW → Source table.
PASS_STUDENT → Target table.
STREAM → Tracks INSERT/UPDATE/DELETE changes.
TASK → Runs SQL automatically on a schedule.
MERGE → Insert new rows and update existing rows.
ROW_NUMBER() → Removes duplicate SID values.
MARKS >= 50 → Filters only passed students.
RESUME → Starts the task.
SUSPEND → Stops the task.
EXECUTE TASK → Runs the task immediately.
