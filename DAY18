+++++++++++++++++++++++++++++++++++++++++++++++;
LOAD THE DATA FROM SOURCE TABLE(STUDENT_RAW) TO TARGET TABLE (STUDENT_PASS)
IF THEY SCORE>=50;



--====================================================
-- STEP 1 : Create Source Table
--====================================================

CREATE OR REPLACE TABLE STUDENT_RAW
(
    SID NUMBER,
    SNAME STRING,
    MARKS NUMBER
);

--====================================================
-- STEP 2 : Create Target Table
--====================================================

CREATE OR REPLACE TABLE PASS_STUDENT
(
    SID NUMBER,
    SNAME STRING,
    MARKS NUMBER
);

--====================================================
-- STEP 3 : Create Stream
--====================================================

CREATE OR REPLACE STREAM STUDENT_STREAM
ON TABLE STUDENT_RAW;

--====================================================
-- STEP 4 : Create Task
--====================================================

--SHOW WAREHOUSES;
CREATE OR REPLACE TASK PASS_STUDENT_TASK
WAREHOUSE = MYWAREHOUSE
SCHEDULE = '1 MINUTE'
AS

MERGE INTO PASS_STUDENT T
USING
(
    SELECT SID, SNAME, MARKS
    FROM (SELECT SID,SNAME,MARKS,ROW_NUMBER()
    OVER(PARTITION BY SID ORDER BY SID) AS RN
          FROM STUDENT_STREAM
          
          WHERE MARKS >= 50
          )
    WHERE RN = 1
) S


ON T.SID = S.SID

WHEN MATCHED THEN
UPDATE SET
    T.SNAME = S.SNAME,
    T.MARKS = S.MARKS

WHEN NOT MATCHED THEN
INSERT(SID,SNAME,MARKS) VALUES(S.SID,S.SNAME,S.MARKS);

--====================================================
-- STEP 5 : Resume Task
--====================================================

SELECT * FROM STUDENT_RAW;

SELECT * FROM PASS_STUDENT;

ALTER TASK PASS_STUDENT_TASK SUSPEND;


