SELECT
    F.ORDER_ID,
    C.CUSTOMER_ID,
    C.CUSTOMER_NAME,
    P.PRODUCT_ID,
    P.PRODUCT_NAME,
    S.SELLER_ID,
    S.SELLER_NAME,
    D.DATE_ID,
    D.ORDER_DATE,
    F.QTY,
    F.SALES_AMOUNT
FROM FACT_ORDERS F
inner JOIN DIM_CUSTOMER C
ON F.CUSTOMER_ID = C.CUSTOMER_ID
inner JOIN DIM_PRODUCT P
ON F.PRODUCT_ID = P.PRODUCT_ID
inner JOIN DIM_SELLER S
ON F.SELLER_ID = S.SELLER_ID
inner JOIN DIM_DATE D
ON F.DATE_ID = D.DATE_ID;





SELECT
    C.CUSTOMER_NAME,
    SUM(F.SALES_AMOUNT) AS TOTAL_SALES
FROM FACT_ORDERS F
JOIN DIM_CUSTOMER C
ON F.CUSTOMER_ID = C.CUSTOMER_ID
GROUP BY C.CUSTOMER_NAME;



SELECT
    P.PRODUCT_NAME,
    SUM(F.SALES_AMOUNT) AS TOTAL_SALES
FROM FACT_ORDERS F
JOIN DIM_PRODUCT P
ON F.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME;


SELECT
    F.ORDER_ID,
    C.CUSTOMER_NAME,
    P.PRODUCT_NAME,
    F.QTY,
    F.SALES_AMOUNT
FROM FACT_ORDERS F
JOIN DIM_CUSTOMER C
ON F.CUSTOMER_ID = C.CUSTOMER_ID
JOIN DIM_PRODUCT P
ON F.PRODUCT_ID = P.PRODUCT_ID;



SELECT
    P.PRODUCT_NAME,
    SUM(F.SALES_AMOUNT) AS TOTAL_SALES
FROM FACT_ORDERS F
JOIN DIM_PRODUCT P
ON F.PRODUCT_ID = P.PRODUCT_ID
GROUP BY P.PRODUCT_NAME
ORDER BY TOTAL_SALES DESC;




