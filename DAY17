-- Raw Table

CREATE OR REPLACE TABLE CUSTOMER_TRANSACTION_RAW
(
    TXN_ID NUMBER,
    CUSTOMER_ID NUMBER,
    AMOUNT NUMBER
);

-- Sample Data

INSERT INTO CUSTOMER_TRANSACTION_RAW VALUES
(1001,101,5000),
(1002,102,3000),
(1003,101,2000),
(1004,103,7000),
(1005,102,1000);

-- Dynamic Table

CREATE OR REPLACE DYNAMIC TABLE DT_CUSTOMER_TRANSACTION
TARGET_LAG = '1 MINUTE'
WAREHOUSE = COMPUTE_WH
AS
SELECT
    CUSTOMER_ID,SUM(AMOUNT) AS TOTAL_AMOUNT
FROM CUSTOMER_TRANSACTION_RAW
GROUP BY CUSTOMER_ID;

-- Check Dynamic Table

SELECT *
FROM DT_CUSTOMER_TRANSACTION;

-- New Transaction

INSERT INTO CUSTOMER_TRANSACTION_RAW
VALUES (1006,101,1500);

-- Check Dynamic Table


SELECT * FROM CUSTOMER_TRANSACTION_RAW

SELECT *
FROM DT_CUSTOMER_TRANSACTION;




